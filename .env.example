# ==============================================================================
# TOKI Backend — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Never commit real credentials or secrets to version control.
# ==============================================================================

# Core Runtime & Profile
# Profiles: 'local' (default dev), 'test', 'cloud', 'demo_offline'
TOKI_PROFILE=local
TOKI_ENV=development
TOKI_LOG_LEVEL=INFO

# Network Bindings
TOKI_APP_HOST=0.0.0.0
TOKI_APP_PORT=8000
TOKI_REQUIRE_TLS=false

# Persistence (PostgreSQL Async)
TOKI_DATABASE_URL=postgresql+asyncpg://toki:toki@localhost:5432/toki
TOKI_DATABASE_POOL_SIZE=10
TOKI_DATABASE_MAX_OVERFLOW=5

# Speech Adapters (ASR & TTS)
# ASR providers: 'fake', 'local', 'managed'
TOKI_ASR_PROVIDER=fake
TOKI_ASR_MODEL=pinned-model
TOKI_ASR_DEADLINE_MS=1200

# TTS providers: 'cached', 'local', 'managed'
TOKI_TTS_PROVIDER=cached
TOKI_TTS_VOICE=pinned-id-ID

# Optional AI Capabilities (ADR-004, ADR-006, ADR-007, ADR-016)
TOKI_SEMANTIC_ENABLED=false
TOKI_SEMANTIC_MODEL=pinned-model

TOKI_LLM_PARAPHRASE_ENABLED=false
TOKI_LLM_MODEL=pinned-model

TOKI_VISION_ENABLED=false

# Optional Cloud Provider Credentials (Leave blank for local/test/demo_offline)
TOKI_CLOUD_ASR_API_KEY=
TOKI_CLOUD_LLM_API_KEY=
TOKI_CLOUD_TTS_API_KEY=

# Curriculum, Safety, and Mastery Governance Versions
TOKI_CURRICULUM_VERSION=dev
TOKI_SAFETY_POLICY_VERSION=CHILD-SAFETY-1.0
TOKI_MASTERY_POLICY_VERSION=RULE-MASTERY-1.0

# Privacy & Media Retention (ADR-013: Must remain false in standard operation)
TOKI_RAW_MEDIA_RETENTION=false
