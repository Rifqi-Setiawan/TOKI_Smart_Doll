{
  "$defs": {
    "DetectedObject": {
      "additionalProperties": false,
      "description": "Recognized object entity within curated activity vocabulary (ADR-010).",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "description": "Semantic contract schema version (API-001)",
          "title": "Schema Version",
          "type": "string"
        },
        "label": {
          "description": "Curated vocabulary object label",
          "title": "Label",
          "type": "string"
        },
        "confidence": {
          "description": "Confidence score from vision model",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "bounding_box": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional [x_min, y_min, x_max, y_max] normalized coordinates [0.0 - 1.0]",
          "title": "Bounding Box"
        }
      },
      "required": [
        "label",
        "confidence"
      ],
      "title": "DetectedObject",
      "type": "object"
    },
    "VisionStatus": {
      "description": "Normalized outcomes for object detection (AI-009, ADR-010).",
      "enum": [
        "DETECTED",
        "UNKNOWN",
        "ABSTAIN",
        "TIMEOUT",
        "ERROR"
      ],
      "title": "VisionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Typed observation payload from triggered camera snapshot (AI-002, AI-009, API-006).",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "description": "Semantic contract schema version (API-001)",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "description": "Authoritative session identifier",
      "title": "Session Id",
      "type": "string"
    },
    "turn_id": {
      "description": "Turn correlation identifier",
      "title": "Turn Id",
      "type": "string"
    },
    "state_version": {
      "description": "Monotonic state version for optimistic concurrency guard (API-006)",
      "minimum": 1,
      "title": "State Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/VisionStatus",
      "description": "Vision detection outcome status"
    },
    "detected_objects": {
      "description": "List of recognized approved objects",
      "items": {
        "$ref": "#/$defs/DetectedObject"
      },
      "title": "Detected Objects",
      "type": "array"
    },
    "freshness_ms": {
      "description": "Age of the camera snapshot in milliseconds (freshness window check)",
      "minimum": 0,
      "title": "Freshness Ms",
      "type": "integer"
    },
    "latency_ms": {
      "description": "Vision adapter execution latency",
      "minimum": 0.0,
      "title": "Latency Ms",
      "type": "number"
    },
    "provider": {
      "description": "Vision model provider name",
      "title": "Provider",
      "type": "string"
    },
    "model_version": {
      "description": "Pinned model version identifier",
      "title": "Model Version",
      "type": "string"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Redacted error detail if status is ERROR/TIMEOUT",
      "title": "Error Message"
    }
  },
  "required": [
    "session_id",
    "turn_id",
    "state_version",
    "status",
    "freshness_ms",
    "latency_ms",
    "provider",
    "model_version"
  ],
  "title": "VisionObservation",
  "type": "object"
}
