{
  "$defs": {
    "ASRStatus": {
      "description": "Normalized outcomes for speech recognition (AI-002).",
      "enum": [
        "SUCCESS",
        "ABSTAIN",
        "UNCERTAIN",
        "NO_SPEECH",
        "TIMEOUT",
        "ERROR"
      ],
      "title": "ASRStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Typed probabilistic speech hypothesis from ASR adapter (AI-002, API-006).",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "description": "Semantic contract schema version (API-001)",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "description": "Authoritative session identifier",
      "title": "Session Id",
      "type": "string"
    },
    "turn_id": {
      "description": "Turn correlation identifier",
      "title": "Turn Id",
      "type": "string"
    },
    "state_version": {
      "description": "Monotonic state version for optimistic concurrency guard (API-006)",
      "minimum": 1,
      "title": "State Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/ASRStatus",
      "description": "Normalized outcome status"
    },
    "transcript": {
      "default": "",
      "description": "Transcribed Indonesian text hypothesis",
      "title": "Transcript",
      "type": "string"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Confidence score [0.0 - 1.0] if provided by adapter",
      "title": "Confidence"
    },
    "language": {
      "default": "id-ID",
      "description": "Detected or pinned language code",
      "title": "Language",
      "type": "string"
    },
    "duration_ms": {
      "description": "Audio segment duration in milliseconds",
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "latency_ms": {
      "description": "Adapter execution latency in milliseconds",
      "minimum": 0.0,
      "title": "Latency Ms",
      "type": "number"
    },
    "provider": {
      "description": "Name of provider adapter (e.g. 'fake', 'local', 'managed')",
      "title": "Provider",
      "type": "string"
    },
    "model_version": {
      "description": "Pinned model version identifier",
      "title": "Model Version",
      "type": "string"
    },
    "is_final": {
      "default": true,
      "description": "Whether this is final turn hypothesis",
      "title": "Is Final",
      "type": "boolean"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Redacted error description if status is ERROR/TIMEOUT",
      "title": "Error Message"
    }
  },
  "required": [
    "session_id",
    "turn_id",
    "state_version",
    "status",
    "duration_ms",
    "latency_ms",
    "provider",
    "model_version"
  ],
  "title": "ASRResult",
  "type": "object"
}
