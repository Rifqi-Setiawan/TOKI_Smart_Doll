{
  "$defs": {
    "TTSSource": {
      "description": "Origin of rendered audio asset (ADR-009).",
      "enum": [
        "CACHED",
        "DYNAMIC",
        "FALLBACK"
      ],
      "title": "TTSSource",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Audio rendering result from TTS adapter (API-006, ADR-009).",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "description": "Semantic contract schema version (API-001)",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "description": "Authoritative session identifier",
      "title": "Session Id",
      "type": "string"
    },
    "turn_id": {
      "description": "Turn correlation identifier",
      "title": "Turn Id",
      "type": "string"
    },
    "state_version": {
      "description": "Monotonic state version for optimistic concurrency guard (API-006)",
      "minimum": 1,
      "title": "State Version",
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/TTSSource",
      "description": "Audio source: CACHED, DYNAMIC, or FALLBACK"
    },
    "audio_asset_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Pre-generated audio asset ID",
      "title": "Audio Asset Id"
    },
    "audio_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Ephemeral audio location or path",
      "title": "Audio Uri"
    },
    "duration_ms": {
      "description": "Audio playback duration in milliseconds",
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "latency_ms": {
      "description": "TTS generation latency in milliseconds",
      "minimum": 0.0,
      "title": "Latency Ms",
      "type": "number"
    },
    "provider": {
      "description": "TTS provider name",
      "title": "Provider",
      "type": "string"
    },
    "voice_id": {
      "description": "Indonesian voice identifier",
      "title": "Voice Id",
      "type": "string"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Error detail if failed",
      "title": "Error Message"
    }
  },
  "required": [
    "session_id",
    "turn_id",
    "state_version",
    "source",
    "duration_ms",
    "latency_ms",
    "provider",
    "voice_id"
  ],
  "title": "TTSResult",
  "type": "object"
}
